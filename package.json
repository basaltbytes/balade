{
  "name": "balade",
  "version": "0.11.0",
  "description": "Human-readable walkthroughs for agent-scale pull requests — a CLI that renders a walkthrough file committed to the repository into an interactive review app.",
  "keywords": [
    "cli",
    "code-review",
    "diff",
    "effect",
    "markdoc",
    "pull-request",
    "react",
    "walkthrough"
  ],
  "homepage": "https://github.com/basaltbytes/balade#readme",
  "bugs": {
    "url": "https://github.com/basaltbytes/balade/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/balade.git"
  },
  "bin": {
    "balade": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:app && pnpm run build:skill",
    "build:cli": "tsc -p tsconfig.build.json && node scripts/copy-prose.mjs",
    "build:app": "vite build app && vite build app --mode export",
    "build:skill": "node dist/cli.js skills install --out dist/skill",
    "dev:app": "vite app",
    "dev:site": "vite site",
    "build:site": "vite build site",
    "build:demo": "pnpm build && mkdir -p site/public/demo && node dist/cli.js build .agents/walkthroughs/pr-95-mermaid-rendering-across-an-untrusted-svg-boundary.md --out site/public/demo/index.html",
    "deploy:site": "pnpm build:demo && pnpm build:site && cd site && wrangler deploy",
    "eval:authoring": "vitest run test/authoring.test.ts test/authoring-eval.test.ts --reporter=verbose",
    "eval:authoring:paid": "vitest run --config vitest.paid.config.ts --reporter=verbose",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json && tsc -p site/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset:version": "changeset version",
    "package:smoke": "bash scripts/npm-smoke.sh",
    "prepare": "effect-tsgo patch",
    "prepublishOnly": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test && pnpm package:smoke"
  },
  "dependencies": {
    "@earendil-works/pi-ai": "0.83.0",
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/platform-node-shared": "4.0.0-beta.102",
    "@markdoc/markdoc": "0.5.8",
    "effect": "4.0.0-beta.102",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.102",
    "@git-diff-view/react": "0.1.7",
    "@oxlint/plugins": "1.78.0",
    "@primer/octicons-react": "19.32.0",
    "@shikijs/langs": "4.4.1",
    "@shikijs/themes": "4.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^27.4.0",
    "mermaid": "11.16.1",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.78.0",
    "pkg-pr-new": "0.0.87",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.32.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
