{
  "name": "balade",
  "version": "0.1.0",
  "description": "Narrated code walkthroughs for pull requests — a CLI that renders a thin, committed walkthrough file into an interactive review app.",
  "keywords": [
    "cli",
    "code-review",
    "diff",
    "effect",
    "markdoc",
    "pull-request",
    "react",
    "walkthrough"
  ],
  "homepage": "https://github.com/basaltbytes/balade#readme",
  "bugs": {
    "url": "https://github.com/basaltbytes/balade/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/balade.git"
  },
  "bin": {
    "balade": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:cli && pnpm run build:app",
    "build:cli": "tsc -p tsconfig.build.json",
    "build:app": "vite build app && vite build app --mode export",
    "dev:app": "vite app",
    "dev:site": "vite site",
    "build:site": "vite build site",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "tsc -p tsconfig.json && tsc -p app/tsconfig.json && tsc -p site/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "package:smoke": "bash scripts/npm-smoke.sh",
    "prepare": "effect-tsgo patch",
    "prepublishOnly": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test && pnpm package:smoke"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-beta.102",
    "@markdoc/markdoc": "0.5.8",
    "effect": "4.0.0-beta.102",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.24.3",
    "@effect/vitest": "4.0.0-beta.102",
    "@git-diff-view/react": "0.1.7",
    "@primer/octicons-react": "19.32.0",
    "@shikijs/langs": "4.4.1",
    "@shikijs/themes": "4.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^27.4.0",
    "oxfmt": "^0.61.0",
    "oxlint": "^1.76.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shiki": "4.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "10.32.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=20"
  }
}
