{
  "name": "balade",
  "version": "0.19.0",
  "description": "Human-readable walkthroughs for agent-scale pull requests. A bring-your-own-agent CLI that turns walkthrough files into interactive review apps.",
  "keywords": [
    "agentic-development",
    "ai-generated-code",
    "code-review",
    "coding-agent",
    "developer-tools",
    "effect",
    "github",
    "pull-request",
    "pull-request-review",
    "walkthrough"
  ],
  "homepage": "https://balade.dev",
  "bugs": {
    "url": "https://github.com/basaltbytes/balade/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/basaltbytes/balade.git"
  },
  "bin": {
    "balade": "./dist/cli.js"
  },
  "files": [
    "dist",
    "deprecated"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/library.d.ts",
      "default": "./dist/library.js"
    },
    "./answers": {
      "types": "./deprecated/core.d.ts",
      "default": "./deprecated/core.js"
    },
    "./contract": {
      "types": "./deprecated/core.d.ts",
      "default": "./deprecated/core.js"
    },
    "./package.json": "./package.json",
    "./viewer": {
      "types": "./deprecated/viewer.d.ts",
      "default": "./deprecated/viewer.js"
    },
    "./viewer.css": "./deprecated/viewer.css"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm run build:packages && pnpm run build:cli && pnpm run build:app && pnpm run build:skill",
    "build:cli": "tsc -p tsconfig.build.json && node scripts/copy-prose.mjs",
    "build:app": "vite build app && vite build app --mode export",
    "build:skill": "node dist/cli.js skills install --out dist/skill",
    "dev:app": "vite app",
    "dev:site": "vite site",
    "build:site": "vite build site",
    "build:demo": "pnpm build && mkdir -p site/public/demo && node dist/cli.js build .agents/walkthroughs/pr-133-clarification-threads-from-selection-to-pinned-answer.md --out site/public/demo/index.html",
    "deploy:site": "pnpm build:demo && pnpm build:site && cd site && wrangler deploy",
    "eval:authoring": "vitest run test/authoring.test.ts test/authoring-eval.test.ts --reporter=verbose",
    "eval:authoring:paid": "vitest run --config vitest.paid.config.ts --reporter=verbose",
    "lint": "oxlint .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "typecheck": "effect-tsgo tsc -p tsconfig.json && effect-tsgo tsc -p app/tsconfig.json && effect-tsgo tsc -p site/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "changeset:version": "changeset version && pnpm install --lockfile-only",
    "package:smoke": "bash scripts/npm-smoke.sh",
    "prepare": "effect-tsgo patch --typescript",
    "build:packages": "pnpm --filter \"./packages/*\" run build",
    "release:check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm build && pnpm test && pnpm package:smoke",
    "changeset:publish": "pnpm build && node scripts/release/publish.mjs && node scripts/release/tag.mjs"
  },
  "dependencies": {
    "@balade/core": "workspace:*",
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@effect/platform-node": "4.1.2",
    "@markdoc/markdoc": "0.5.8",
    "effect": "4.1.2",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.0",
    "@cloudflare/vite-plugin": "^1.50.0",
    "@effect/tsgo": "0.64.1",
    "@effect/vitest": "4.1.2",
    "@git-diff-view/react": "0.1.7",
    "@oxlint/plugins": "1.90.0",
    "@playwright/test": "1.58.2",
    "@primer/octicons-react": "19.32.0",
    "@shikijs/langs": "4.4.1",
    "@shikijs/themes": "4.4.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^27.4.0",
    "lowlight": "3.3.0",
    "mermaid": "11.16.1",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "pkg-pr-new": "0.0.87",
    "postcss": "8.5.6",
    "postcss-selector-parser": "7.1.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "rolldown": "1.2.1",
    "shiki": "4.4.1",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^5.1.0",
    "wrangler": "^4.118.0"
  },
  "peerDependencies": {
    "@balade/viewer": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@balade/viewer": {
      "optional": true
    }
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.20.0",
      "onFail": "download"
    }
  },
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  }
}
