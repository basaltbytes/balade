{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["unicorn", "typescript", "oxc", "import"],
  "jsPlugins": [{ "name": "balade", "specifier": "./tools/oxlint/plugin.ts" }],
  "categories": { "correctness": "error" },
  "rules": {
    "import/no-cycle": "error",
    "balade/no-chained-type-assertions": "error",
    "balade/no-conditional-empty-object-spread": "error",
    "balade/no-known-value-widening": "error",
    "balade/no-module-mocking": "error",
    "balade/no-object-parameters": "error",
    "balade/no-reflect-apply": "error",
    "balade/no-reflect-get": "error",
    "balade/no-runtime-typeof": "error",
    "balade/no-shape-in-symbol-names": "error",
    "balade/no-unknown-parameters": "error",
    "balade/no-unknown-returns": "error",
    "balade/no-unknown-type-aliases": "error",
    "balade/no-unsafe-dictionary-type": "error",
    "balade/no-widen-then-assert": "error",
    "balade/require-safety-comment-for-type-assertion": "error"
  }
}
